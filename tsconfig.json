{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/ts/*"]
        },
        "noEmit": true
    },
    "include": [
        "resources/ts/**/*",
        "api/**/*",
        "vite.config.ts",
        "drizzle.config.ts"
    ]
}
